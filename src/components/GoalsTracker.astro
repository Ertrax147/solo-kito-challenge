---
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 border-t border-slate-800/80">
	<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
		<div>
			<h2 class="font-display text-2xl sm:text-3xl font-bold tracking-wide text-white flex items-center gap-3">
				<span>Metas & Logros del Challenge</span>
				<span class="text-xs font-semibold text-emerald-400 bg-emerald-500/10 border border-emerald-500/30 px-3 py-1 rounded-full">
					Pick'em Personal
				</span>
			</h2>
			<p class="text-sm text-slate-400">Objetivos fijados para las 3 semanas de competición</p>
		</div>
	</div>

	<!-- Goals Grid -->
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
		
		<!-- Goal 1 -->
		<div class="glass-panel rounded-2xl p-5 border-yellow-500/30 relative overflow-hidden">
			<div class="flex items-center justify-between mb-3">
				<span class="text-xs font-bold uppercase tracking-wider text-yellow-400">Meta #1</span>
				<span class="text-xs font-extrabold text-slate-400 bg-slate-900 px-2 py-0.5 rounded">78.4%</span>
			</div>
			<h3 class="font-display font-bold text-lg text-white mb-1">Peak Challenger 1000 LP</h3>
			<p class="text-xs text-slate-400 mb-3">Alcanzar los 1000 LP en Kito Main antes del fin del desafío.</p>
			
			<div class="w-full h-2 bg-slate-900 rounded-full overflow-hidden mb-2">
				<div class="h-full bg-gradient-to-r from-yellow-500 to-[#E9FF1F]" style="width: 78.4%"></div>
			</div>
			<div class="text-[11px] text-slate-400 flex justify-between font-medium">
				<span>784 LP Actuales</span>
				<span>Meta: 1000 LP</span>
			</div>
		</div>

		<!-- Goal 2 -->
		<div class="glass-panel rounded-2xl p-5 border-emerald-500/40 relative overflow-hidden bg-emerald-950/20">
			<div class="flex items-center justify-between mb-3">
				<span class="text-xs font-bold uppercase tracking-wider text-emerald-400">Meta #2</span>
				<span class="text-xs font-extrabold text-emerald-300 bg-emerald-500/20 px-2 py-0.5 rounded border border-emerald-500/40">COMPLETADO 🏆</span>
			</div>
			<h3 class="font-display font-bold text-lg text-white mb-1">&gt; 70% WR en Tryhard</h3>
			<p class="text-xs text-slate-400 mb-3">Mantener un winrate aplastante en la cuenta Kito Tryhard Top.</p>
			
			<div class="w-full h-2 bg-slate-900 rounded-full overflow-hidden mb-2">
				<div class="h-full bg-emerald-400" style="width: 100%"></div>
			</div>
			<div class="text-[11px] text-slate-400 flex justify-between font-medium">
				<span class="text-emerald-400 font-bold">71.4% WR Actual</span>
				<span>Meta: 70%</span>
			</div>
		</div>

		<!-- Goal 3 -->
		<div class="glass-panel rounded-2xl p-5 border-cyan-500/30 relative overflow-hidden">
			<div class="flex items-center justify-between mb-3">
				<span class="text-xs font-bold uppercase tracking-wider text-cyan-400">Meta #3</span>
				<span class="text-xs font-extrabold text-slate-400 bg-slate-900 px-2 py-0.5 rounded">94.6%</span>
			</div>
			<h3 class="font-display font-bold text-lg text-white mb-1">Maratón 150 Partidas</h3>
			<p class="text-xs text-slate-400 mb-3">Superar las 150 partidas disputadas en directo en total.</p>
			
			<div class="w-full h-2 bg-slate-900 rounded-full overflow-hidden mb-2">
				<div class="h-full bg-gradient-to-r from-cyan-500 to-teal-300" style="width: 94.6%"></div>
			</div>
			<div class="text-[11px] text-slate-400 flex justify-between font-medium">
				<span>142 Partidas Jugadas</span>
				<span>Meta: 150 Partidas</span>
			</div>
		</div>

		<!-- Goal 4 -->
		<div class="glass-panel rounded-2xl p-5 border-purple-500/30 relative overflow-hidden">
			<div class="flex items-center justify-between mb-3">
				<span class="text-xs font-bold uppercase tracking-wider text-purple-400">Meta #4</span>
				<span class="text-xs font-extrabold text-slate-400 bg-slate-900 px-2 py-0.5 rounded">60%</span>
			</div>
			<h3 class="font-display font-bold text-lg text-white mb-1">Superar 5 Blue Shells</h3>
			<p class="text-xs text-slate-400 mb-3">Ganar partidas bajo los sabotajes aleatorios de la ruleta.</p>
			
			<div class="w-full h-2 bg-slate-900 rounded-full overflow-hidden mb-2">
				<div class="h-full bg-gradient-to-r from-purple-500 to-pink-500" style="width: 60%"></div>
			</div>
			<div class="text-[11px] text-slate-400 flex justify-between font-medium">
				<span>3 Retos Cumplidos</span>
				<span>Meta: 5 Retos</span>
			</div>
		</div>

	</div>
</section>
