		const nameInput = document.getElementById('modal-name') as HTMLInputElement;
		const tagInput = document.getElementById('modal-tag') as HTMLInputElement;
		const regionInput = document.getElementById('modal-region') as HTMLSelectElement;
		const roleInput = document.getElementById('modal-role') as HTMLSelectElement;

		const gameName = nameInput.value.trim();
		const tagClean = tagInput.value.trim().replace('#','');

		submitSpinner?.classList.remove('hidden');

		let fetchedData: any = {};
		try {
			const storedKey = localStorage.getItem('riot_api_key_v1') || '';
			const apiKeyParam = storedKey ? `&apiKey=${storedKey}` : '';
			const res = await fetch(`/api/summoner?gameName=${encodeURIComponent(gameName)}&tagLine=${encodeURIComponent(tagClean)}&region=${regionInput.value}${apiKeyParam}`);
			fetchedData = await res.json();
		} catch (err) {} finally {
			submitSpinner?.classList.add('hidden');
		}

		const newAcc = {
			id: Date.now().toString(),
			name: gameName,
			tag: `#${tagClean}`,
			region: regionInput.value,
			role: roleInput.value,
			rank: fetchedData.tier || 'UNRANKED',
			lp: fetchedData.lp ?? 0,
			wins: fetchedData.wins ?? 0,
			losses: fetchedData.losses ?? 0,
			posDelta: '▲1',
			avgGain: 28,
			avgLoss: 14,
			sparkline: '10,30 25,20 40,15 55,10 70,5',
			isLive: true,
			profileIconUrl: fetchedData.profileIconUrl || FALLBACK_ICON,
			opggUrl: `https://www.op.gg/summoners/${regionInput.value.toLowerCase()}/${encodeURIComponent(gameName)}-${tagClean}`
		};

		// Guardar vía Live Netlify Blobs API para que persista para TODOS los usuarios/dispositivos al instante
		try {
			const dbRes = await fetch(API_URL, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(newAcc)
			});
			if (dbRes.ok) {
				const postData = await dbRes.json();
				if (postData.accounts) accounts = postData.accounts;
			}
		} catch(e) {
			accounts.push(newAcc);
		}

		render();
		accountModal.classList.add('opacity-0', 'pointer-events-none');
	});

	const exportBtn = document.getElementById('export-btn');
	const importBtn = document.getElementById('import-btn');
	const importFile = document.getElementById('import-file') as HTMLInputElement;

	exportBtn?.addEventListener('click', () => {
		const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(accounts, null, 2));
		const downloadAnchorNode = document.createElement('a');
		downloadAnchorNode.setAttribute("href", dataStr);
		downloadAnchorNode.setAttribute("download", "cuentas_solokito.json");
		document.body.appendChild(downloadAnchorNode);
		downloadAnchorNode.click();
		downloadAnchorNode.remove();
	});

	importBtn?.addEventListener('click', () => {
		importFile?.click();
	});

	importFile?.addEventListener('change', (e) => {
		const file = (e.target as HTMLInputElement).files?.[0];
		if (!file) return;

		const reader = new FileReader();
		reader.onload = async (event) => {
			try {
				const json = JSON.parse(event.target?.result as string);
				if (Array.isArray(json)) {
					const res = await fetch(API_URL, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify(json)
					});
					if (res.ok) {
						const data = await res.json();
						if (data.accounts) {
							accounts = data.accounts;
							render();
							alert('✅ Cuentas importadas exitosamente');
						}
					} else {
						alert('❌ Error al guardar las cuentas importadas');
					}
				} else {
					alert('❌ El archivo no tiene el formato correcto (debe ser un array JSON)');
				}
			} catch (err) {
				alert('❌ Error al leer el archivo JSON');
			}
			// Reiniciar input
			importFile.value = '';
		};
		reader.readAsText(file);
	});

	fetchGlobalAccounts();
	// Retrasamos el primer refresco automático y lo ejecutamos cada 2 minutos (120000 ms) para no saturar la API
	setTimeout(silentAutoRefreshAll, 5000);
	setInterval(silentAutoRefreshAll, 120000);
</script>
