	const SPELL_MAP: Record<number, string> = {
		1: "SummonerBoost", 3: "SummonerExhaust", 4: "SummonerFlash", 
		6: "SummonerHaste", 7: "SummonerHeal", 11: "SummonerSmite", 
		12: "SummonerTeleport", 13: "SummonerMana", 14: "SummonerDot", 
		21: "SummonerBarrier", 32: "SummonerSnowball"
	};

	const RUNE_TREES: Record<number, string> = {
		8100: "7200_domination",
		8300: "7203_whimsy",
		8000: "7201_precision",
		8400: "7204_resolve",
		8200: "7202_sorcery"
	};

	function getTimeAgo(timestamp: number) {
		const seconds = Math.floor((Date.now() - timestamp) / 1000);
		let interval = seconds / 31536000;
		if (interval > 1) return Math.floor(interval) + " años";
		interval = seconds / 2592000;
		if (interval > 1) return Math.floor(interval) + " meses";
		interval = seconds / 86400;
		if (interval > 1) return Math.floor(interval) + " d";
		interval = seconds / 3600;
		if (interval > 1) return Math.floor(interval) + " h";
		interval = seconds / 60;
		if (interval > 1) return Math.floor(interval) + " min";
		return Math.floor(seconds) + " seg";
	}

	function formatDuration(seconds: number) {
		const m = Math.floor(seconds / 60);
		const s = seconds % 60;
		return `${m}:${s.toString().padStart(2, '0')}`;
	}

	function generateMatchRow(m: any) {
		const isWin = m.win;
		const resultText = isWin ? 'Victoria' : 'Derrota';
		const resultColor = isWin ? 'text-emerald-300' : 'text-rose-300';
		const borderLeft = isWin ? 'border-l-emerald-400/80' : 'border-l-rose-500/80';
		
		const spell1 = SPELL_MAP[m.summoner1Id] || 'SummonerFlash';
		const spell2 = SPELL_MAP[m.summoner2Id] || 'SummonerFlash';
		
		const rune1 = RUNE_TREES[m.primaryStyle] || '7200_domination';
		const rune2 = RUNE_TREES[m.subStyle] || '7201_precision';

		const champUrl = `https://ddragon.leagueoflegends.com/cdn/14.15.1/img/champion/${m.championName}.png`;
		const oppChampUrl = m.opponentChampion !== 'unknown' 
			? `https://ddragon.leagueoflegends.com/cdn/14.15.1/img/champion/${m.opponentChampion}.png` 
			: '/favicon.svg';

		const itemsHtml = m.items.map((itemId: number, idx: number) => {
			const isTrinket = idx === 6;
			const extraClasses = isTrinket ? "ml-1 border border-yellow-200/20" : "";
			if (!itemId || itemId === 0) return `<span class="h-[22px] w-[22px] rounded bg-black/30 ${extraClasses}"></span>`;
			return `<img src="https://ddragon.leagueoflegends.com/cdn/14.15.1/img/item/${itemId}.png" class="h-[22px] w-[22px] rounded bg-black/50 object-cover ${extraClasses}" alt="Item" />`;
		}).join('');

		const csPerMin = m.gameDuration > 0 ? (m.cs / (m.gameDuration / 60)).toFixed(1) : "0.0";

		return `
			<div class="rounded-xl border border-white/[0.05] border-l-[3px] bg-[#14161d] transition-colors ${borderLeft}">
				<button type="button" class="grid w-full grid-cols-[130px_auto_1fr_auto_88px_26px] items-center gap-3 rounded-xl px-3 py-2 text-left transition-colors hover:bg-white/[0.03] sm:gap-4">
					
					<!-- Lado Izquierdo: Resultado y Tiempo -->
					<div class="flex items-baseline gap-1.5 whitespace-nowrap">
						<span class="text-[13px] font-extrabold ${resultColor}">${resultText}</span>
						<span class="text-[10px] text-white/65">${formatDuration(m.gameDuration)} · hace ${getTimeAgo(m.gameCreation)}</span>
					</div>
					
					<!-- Campeón, Spells y Runas -->
					<div class="flex items-center gap-2">
						<div class="flex items-center gap-[3px]">
							<div class="shrink-0 overflow-hidden rounded-lg bg-black/40 ring-1 ring-white/10" style="width: 38px; height: 38px;">
								<img src="${champUrl}" class="h-full w-full object-cover" alt="${m.championName}" />
							</div>
							<div class="flex flex-col gap-[2px]">
								<img src="https://ddragon.leagueoflegends.com/cdn/14.15.1/img/spell/${spell1}.png" class="bg-black/50 object-cover rounded" style="width: 18px; height: 18px;" alt="Spell" />
								<img src="https://ddragon.leagueoflegends.com/cdn/14.15.1/img/spell/${spell2}.png" class="bg-black/50 object-cover rounded" style="width: 18px; height: 18px;" alt="Spell" />
							</div>
							<div class="flex flex-col gap-[2px]">
								<img src="https://raw.communitydragon.org/latest/plugins/rcp-be-lol-game-data/global/default/v1/perk-images/styles/${rune1}.png" class="bg-black/50 object-cover rounded-full object-contain p-[1px]" style="width: 18px; height: 18px;" alt="Rune" onerror="this.src='/favicon.svg'" />
								<img src="https://raw.communitydragon.org/latest/plugins/rcp-be-lol-game-data/global/default/v1/perk-images/styles/${rune2}.png" class="bg-black/50 object-cover rounded-full object-contain p-[1px]" style="width: 18px; height: 18px;" alt="Rune" onerror="this.src='/favicon.svg'" />
							</div>
						</div>
						
						<!-- VS Oponente -->
						<span class="px-0.5 text-[10px] font-semibold uppercase text-white/65">vs</span>
						<div class="flex items-center gap-[3px]">
							<div class="shrink-0 overflow-hidden rounded-lg bg-black/40 ring-1 ring-white/10" style="width: 32px; height: 32px;">
								<img src="${oppChampUrl}" class="h-full w-full object-cover" onerror="this.style.display='none'" alt="Opponent" />
							</div>
						</div>
					</div>
					
					<!-- KDA y Estadísticas -->
					<div class="min-w-0 text-center">
						<span class="text-[15px] font-extrabold tabular-nums text-white">
							${m.kills} <span class="text-white/50">/</span> <span class="text-rose-300">${m.deaths}</span> <span class="text-white/50">/</span> ${m.assists}
						</span>
						<span class="ml-2 text-[11px] font-medium text-white/70">${m.kdaRatio} KDA · ${m.kp}% KP · ${m.cs} CS <span class="text-white/40">(${csPerMin})</span></span>
					</div>
					
					<!-- Objetos -->
					<div class="hidden items-center gap-[3px] lg:flex">
						${itemsHtml}
					</div>
					
					<!-- Cambio de LP -->
					<div class="flex items-center justify-end gap-1.5 whitespace-nowrap text-right">
						<span class="text-[13px] font-extrabold tabular-nums ${resultColor}">${m.lpChange}</span>
					</div>

					<span class="flex h-5 w-5 items-center justify-center text-[10px] text-white/60 transition-transform" aria-hidden="true">▼</span>
				</button>
			</div>
		`;
	}

	// Caché para las partidas cargadas
	const matchesCache = new Map();

	(window as any).switchTab = function(id: string, tab: string) {
		const btnHistorial = document.getElementById(`tab-historial-${id}`);
		const btnStats = document.getElementById(`tab-stats-${id}`);
		const contentDiv = document.getElementById(`history-content-${id}`);
		
		if (!btnHistorial || !btnStats || !contentDiv) return;

		// Estilos de activo/inactivo
		const activeClass = 'bg-[#E9FF1F] text-black shadow-[0_0_10px_rgba(233,255,31,0.2)]'.split(' ');
		const inactiveClass = 'text-white/70 hover:text-white'.split(' ');

		if (tab === 'historial') {
			btnHistorial.classList.add(...activeClass);
			btnHistorial.classList.remove(...inactiveClass);
			btnStats.classList.add(...inactiveClass);
			btnStats.classList.remove(...activeClass);

			const data = matchesCache.get(id);
			if (data && data.matches) {
				contentDiv.innerHTML = `<div class="w-full space-y-1.5">${data.matches.map(m => generateMatchRow(m)).join('')}</div>`;
			}
		} else if (tab === 'stats') {
			btnStats.classList.add(...activeClass);
			btnStats.classList.remove(...inactiveClass);
			btnHistorial.classList.add(...inactiveClass);
			btnHistorial.classList.remove(...activeClass);

			const data = matchesCache.get(id);
			if (data && data.matches && data.matches.length > 0) {
				// Calcular estadísticas resumidas
				let totalKills = 0, totalDeaths = 0, totalAssists = 0;
				let wins = 0;
				data.matches.forEach(m => {
					totalKills += m.kills;
					totalDeaths += m.deaths;
					totalAssists += m.assists;
					if (m.win) wins++;
				});
				const totalGames = data.matches.length;
				const winRate = Math.round((wins / totalGames) * 100);
				const avgKills = (totalKills / totalGames).toFixed(1);
				const avgDeaths = (totalDeaths / totalGames).toFixed(1);
				const avgAssists = (totalAssists / totalGames).toFixed(1);
				const avgKda = totalDeaths === 0 ? 'Perfecto' : ((totalKills + totalAssists) / totalDeaths).toFixed(2);

				contentDiv.innerHTML = `
					<div class="flex gap-4 p-4">
						<!-- Winrate Circular -->
						<div class="flex flex-col items-center justify-center bg-black/40 p-4 rounded-xl border border-white/5 w-1/3">
							<div class="relative w-24 h-24 flex items-center justify-center rounded-full border-4 ${winRate >= 50 ? 'border-emerald-400' : 'border-rose-400'}">
								<span class="text-2xl font-black text-white">${winRate}%</span>
							</div>
							<div class="text-xs font-bold text-slate-400 mt-3">${wins} Victorias / ${totalGames - wins} Derrotas</div>
							<div class="text-[10px] text-slate-500 uppercase tracking-widest mt-1">Últimas ${totalGames} partidas</div>
						</div>
						
						<!-- Stats KDA -->
						<div class="flex flex-col justify-center bg-black/40 p-5 rounded-xl border border-white/5 w-2/3">
							<h4 class="text-xs font-black text-slate-400 uppercase tracking-widest mb-4">Rendimiento Promedio</h4>
							<div class="flex items-end gap-3 mb-2">
								<div class="text-3xl font-display font-black text-white">${avgKda}</div>
								<div class="text-sm font-bold text-slate-500 mb-1">KDA RATIO</div>
							</div>
							<div class="flex items-center gap-2 text-lg font-bold">
								<span class="text-emerald-300">${avgKills}</span>
								<span class="text-slate-600">/</span>
								<span class="text-rose-400">${avgDeaths}</span>
								<span class="text-slate-600">/</span>
								<span class="text-white/80">${avgAssists}</span>
							</div>
						</div>
					</div>
				`;
			} else {
				contentDiv.innerHTML = `<div class="text-center py-6 text-slate-500 font-semibold">No hay suficientes datos para generar estadísticas.</div>`;
			}
		}
	};

	(window as any).toggleHistory = async function(id: string, puuid: string, region: string) {
		const row = document.getElementById(`history-row-${id}`);
		if (!row) return;

		// Si está cerrado, abrimos (y cerramos los demás)
		if (row.classList.contains('hidden')) {
			document.querySelectorAll('[id^="history-row-"]').forEach(r => {
				r.classList.add('hidden');
				// Quitar highlight de filas
				const prevRow = r.previousElementSibling;
				if (prevRow) {
					prevRow.classList.remove('bg-[#1a1e2d]', 'border-[#E9FF1F]/50');
				}
			});
			
			row.classList.remove('hidden');
			const mainRow = row.previousElementSibling;
			if (mainRow) {
				mainRow.classList.add('bg-[#1a1e2d]', 'border-[#E9FF1F]/50');
			}

			const contentDiv = document.getElementById(`history-content-${id}`);
			if (contentDiv && !contentDiv.dataset.loaded) {
				if (!puuid) {
					contentDiv.innerHTML = `<div class="text-center py-6 text-slate-500 font-semibold">El PUUID no está disponible. Espera el auto-refresh o re-importa la cuenta.</div>`;
					return;
				}

				contentDiv.innerHTML = `
					<div class="flex flex-col items-center justify-center py-8">
						<div class="w-6 h-6 border-2 border-[#E9FF1F] border-t-transparent rounded-full animate-spin mb-2"></div>
						<div class="text-xs text-slate-400 font-bold">Cargando últimas partidas...</div>
					</div>
				`;

				try {
					const storedKey = localStorage.getItem('riot_api_key_v1') || '';
					const apiKeyParam = storedKey ? `&apiKey=${storedKey}` : '';
					const res = await fetch(`/api/matches?puuid=${puuid}&region=${region}${apiKeyParam}`);
					const data = await res.json();
					if (data.success && data.matches.length > 0) {
						matchesCache.set(id, data); // Guardar en caché
						contentDiv.innerHTML = `<div class="w-full space-y-1.5">${data.matches.map(m => generateMatchRow(m)).join('')}</div>`;
						contentDiv.dataset.loaded = 'true';
						
						// Reset tab to historial
						(window as any).switchTab(id, 'historial');
					} else {
						contentDiv.innerHTML = `<div class="text-center py-6 text-slate-500 font-semibold">${data.error || 'No se encontraron partidas recientes.'}</div>`;
					}
				} catch (e) {
					contentDiv.innerHTML = `<div class="text-center py-6 text-rose-400 font-semibold">Error al cargar historial. Intenta nuevamente más tarde.</div>`;
				}
			} else {
				// Si ya estaba cargado, asegurarnos de volver a la pestaña historial por defecto al abrir
				(window as any).switchTab(id, 'historial');
			}
		} else {
			row.classList.add('hidden');
			const mainRow = row.previousElementSibling;
			if (mainRow) {
				mainRow.classList.remove('bg-[#1a1e2d]', 'border-[#E9FF1F]/50');
			}
		}
	};

	// Auto-Actualización Silenciosa de Stats en Vivo desde la API de Riot
	async function silentAutoRefreshAll() {
		let hasChanges = false;
		const storedKey = localStorage.getItem('riot_api_key_v1') || '';
		const apiKeyParam = storedKey ? `&apiKey=${storedKey}` : '';
		
		for (const acc of accounts) {
			try {
				const tagClean = acc.tag.replace('#','');
				const res = await fetch(`/api/summoner?gameName=${encodeURIComponent(acc.name)}&tagLine=${encodeURIComponent(tagClean)}&region=${acc.region || 'LAS'}${apiKeyParam}`);
				const data = await res.json();

				if (data.success) {
					let changed = false;
					if (acc.rank !== data.tier && data.tier) { acc.rank = data.tier; changed = true; }
					if (acc.lp !== data.lp && data.lp !== undefined) { acc.lp = data.lp; changed = true; }
					if (acc.wins !== data.wins && data.wins !== undefined) { acc.wins = data.wins; changed = true; }
					if (acc.losses !== data.losses && data.losses !== undefined) { acc.losses = data.losses; changed = true; }
					
					if (data.puuid && acc.puuid !== data.puuid) {
						acc.puuid = data.puuid;
						changed = true;
					}

					if (data.profileIconUrl && acc.profileIconUrl !== data.profileIconUrl) {
						acc.profileIconUrl = data.profileIconUrl;
						changed = true;
					}

					if (changed) {
						hasChanges = true;
						// Sincronizar silenciosamente en segundo plano con Netlify Blobs para que otros dispositivos (celular) vean lo mismo
						fetch(API_URL, {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify(acc)
						}).catch(() => {});
					}
				}
				// Añadir un retraso de 600ms entre cada cuenta para evitar saturar el límite de peticiones de Riot (Rate Limit 429)
				await new Promise(r => setTimeout(r, 600));
			} catch(e) {}
		}

		if (hasChanges) render();
	}

	(window as any).deleteAccount = async function(id) {
		if (confirm('¿Eliminar cuenta de la lista?')) {
			try {
				const res = await fetch(`${API_URL}?id=${id}`, { method: 'DELETE' });
				if (res.ok) {
					const data = await res.json();
					if (data.accounts) accounts = data.accounts;
				}
			} catch(e) {}
			render();
		}
	};

